# Copy to .env and fill in. Never commit .env.

# Your Google Cloud project id (Console > project picker). Example: my-ai-credits-123456
GOOGLE_CLOUD_PROJECT=

# Keys your apps and n8n will send in the X-API-Key header. Comma-separated, one per app.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
PROXY_API_KEYS=

# Optional overrides
# TEXT_LOCATION=global
# MEDIA_LOCATION=us-central1
# DEFAULT_TEXT_MODEL=gemini-3.8-flash
# DEFAULT_IMAGE_MODEL=gemini-3.1-flash-image
# DEFAULT_TTS_MODEL=gemini-2.5-flash-tts
# DEFAULT_VIDEO_MODEL=veo-3.1-lite-generate-001
# VIDEO_WAIT_SECONDS=300
