{
  "name": "Vertex proxy: caption, image and voice",
  "nodes": [
    {
      "parameters": {},
      "id": "7d0c5a36-1f4e-4a55-9a8e-000000000001",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "topic",
              "value": "a cozy mountain cabin in winter",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "7d0c5a36-1f4e-4a55-9a8e-000000000002",
      "name": "Topic",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [220, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://vertex-proxy:8080/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'gemini-3.8-flash', messages: [{ role: 'user', content: 'Write one short, warm Instagram caption (max 25 words, no hashtags) about: ' + $json.topic }] }) }}",
        "options": { "timeout": 60000 }
      },
      "id": "7d0c5a36-1f4e-4a55-9a8e-000000000003",
      "name": "Write a caption",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 0]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "b1",
              "name": "caption",
              "value": "={{ $json.choices[0].message.content.trim() }}",
              "type": "string"
            },
            {
              "id": "b2",
              "name": "topic",
              "value": "={{ $('Topic').item.json.topic }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "7d0c5a36-1f4e-4a55-9a8e-000000000004",
      "name": "Caption",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [660, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://vertex-proxy:8080/v1/image?binary=1",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ prompt: 'Warm cinematic photo, ' + $json.topic, aspect_ratio: '4:3' }) }}",
        "options": {
          "response": { "response": { "responseFormat": "file", "outputPropertyName": "image" } },
          "timeout": 120000
        }
      },
      "id": "7d0c5a36-1f4e-4a55-9a8e-000000000005",
      "name": "Illustrate it",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [880, -100]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://vertex-proxy:8080/v1/tts?binary=1",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: $json.caption, voice: 'Aoede', style: 'Say warmly and calmly' }) }}",
        "options": {
          "response": { "response": { "responseFormat": "file", "outputPropertyName": "audio" } },
          "timeout": 120000
        }
      },
      "id": "7d0c5a36-1f4e-4a55-9a8e-000000000006",
      "name": "Read it aloud",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [880, 100]
    }
  ],
  "connections": {
    "Manual Trigger": { "main": [[{ "node": "Topic", "type": "main", "index": 0 }]] },
    "Topic": { "main": [[{ "node": "Write a caption", "type": "main", "index": 0 }]] },
    "Write a caption": { "main": [[{ "node": "Caption", "type": "main", "index": 0 }]] },
    "Caption": {
      "main": [
        [
          { "node": "Illustrate it", "type": "main", "index": 0 },
          { "node": "Read it aloud", "type": "main", "index": 0 }
        ]
      ]
    }
  },
  "settings": { "executionOrder": "v1" },
  "pinData": {}
}
